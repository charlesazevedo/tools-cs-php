<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPMD 2.15.0 - configuração "padrão".
  O PHPMD não tem ruleset implícito: o 3º argumento (ruleset) é obrigatório
  (src/main/php/PHPMD/TextUI/CommandLineOptions.php). Adota-se o ruleset de
  exemplo documentado no README.rst da tag 2.15.0, que referencia os seis
  rulesets embutidos com seus limiares padrão. Equivale a:
    phpmd <fonte> <formato> cleancode,codesize,controversial,design,naming,unusedcode
  (invocação usada no experimento original).
-->
<ruleset name="PHPMD padrao"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Seis rulesets embutidos do PHPMD 2.15.0, limiares padrão.</description>
    <rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/controversial.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
